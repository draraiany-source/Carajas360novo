# Functions env (NÃO commitar valores reais)
# Copie para .env local ou configure no Secret Manager / Cloud Run.

# false = staging (padrão). true só com token real e ambiente controlado.
PAYMENTS_ENABLED=false

# Obrigar App Check nas callables (deixe false até configurar o App Check).
ENFORCE_APP_CHECK=false

# Secrets — nunca no Git:
# MERCADOPAGO_ACCESS_TOKEN=
# ANTHROPIC_API_KEY=
