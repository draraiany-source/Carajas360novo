rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function isOwner(id) { return isAuth() && uid() == id; }
    function isAdminClaim() {
      return isAuth() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin'
      );
    }
    function isAdmin() {
      return isAdminClaim() ||
        (isAuth() &&
          exists(/databases/$(database)/documents/users/$(uid())) &&
          get(/databases/$(database)/documents/users/$(uid())).data.type == 'admin');
    }
    function userProtectedKeys() {
      return [
        'type', 'role', 'roles', 'adminRole', 'verified', 'active', 'plan',
        'walletId', 'financialStatus', 'permissions', 'createdAt', 'xp', 'status'
      ];
    }
    function ownsCompany(companyId) {
      return isAuth() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/companies/$(companyId)) &&
          get(/databases/$(database)/documents/companies/$(companyId)).data.ownerId == uid())
      );
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) &&
        request.resource.data.type in ['client', 'provider', 'deliverer', 'company'] &&
        !('adminRole' in request.resource.data.keys());
      allow update: if (isOwner(userId) &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(userProtectedKeys())) ||
        isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /providers/{providerId} {
      allow read: if true;
      allow create: if isOwner(providerId) &&
        request.resource.data.get('verified', false) == false &&
        request.resource.data.get('userId', providerId) == uid();
      allow update: if isAdmin() || (
        isOwner(providerId) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['verified', 'plan', 'status', 'rating', 'totalReviews', 'userId', 'registrationVerified']) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['active']) ||
          resource.data.verified == true
        )
      );
      allow delete: if isAdmin();
    }

    match /companies/{companyId} {
      allow read: if true;
      allow create: if isAuth() &&
        request.resource.data.ownerId == uid() &&
        request.resource.data.get('verified', false) == false &&
        request.resource.data.get('plan', 'free') == 'free';
      allow update: if isAdmin() || (
        resource.data.ownerId == uid() &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['verified', 'plan', 'ownerId', 'active'])
      );
      allow delete: if isAdmin();
    }

    match /employees/{employeeId} {
      allow read: if isAdmin() ||
        (isAuth() && resource.data.get('userId', '') == uid()) ||
        (isAuth() && ownsCompany(resource.data.companyId));
      allow create: if ownsCompany(request.resource.data.companyId);
      allow update: if ownsCompany(resource.data.companyId);
      allow delete: if ownsCompany(resource.data.companyId);
    }

    match /branches/{branchId} {
      allow read: if true;
      allow create: if ownsCompany(request.resource.data.companyId);
      allow update: if ownsCompany(resource.data.companyId);
      allow delete: if ownsCompany(resource.data.companyId);
    }

    match /stores/{storeId} {
      allow read: if true;
      allow create: if isAuth() && request.resource.data.ownerId == uid();
      allow update, delete: if isAuth() &&
        (resource.data.ownerId == uid() || isAdmin());
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isAuth() &&
        (ownsCompany(request.resource.data.get('companyId', '')) ||
         get(/databases/$(database)/documents/stores/$(request.resource.data.storeId)).data.ownerId == uid() ||
         isAdmin());
      allow update: if isAuth() &&
        (get(/databases/$(database)/documents/stores/$(resource.data.storeId)).data.ownerId == uid() || isAdmin());
      allow delete: if isAuth() &&
        (get(/databases/$(database)/documents/stores/$(resource.data.storeId)).data.ownerId == uid() || isAdmin());
    }

    match /rentals/{rentalId} {
      allow read: if true;
      allow create: if isAuth() && request.resource.data.ownerId == uid();
      allow update, delete: if isAuth() &&
        (resource.data.ownerId == uid() || isAdmin());
    }

    match /bookings/{bookingId} {
      allow read: if isAuth() &&
        (resource.data.clientId == uid() ||
         resource.data.ownerId == uid() || isAdmin());
      allow create: if isAuth() && request.resource.data.clientId == uid();
      allow update: if isAuth() &&
        (resource.data.ownerId == uid() ||
         resource.data.clientId == uid() || isAdmin()) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['price', 'total', 'clientId', 'ownerId', 'rentalId']);
    }

    match /contracts/{contractId} {
      allow read: if isAdmin() || ownsCompany(resource.data.companyId);
      allow create, update: if ownsCompany(request.resource.data.companyId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAuth() && (
        resource.data.clientId == uid() ||
        resource.data.providerId == uid() ||
        isAdmin()
      );
      allow create: if isAuth()
        && request.resource.data.clientId == uid()
        && request.resource.data.status == 'pending'
        && request.resource.data.get('payoutProcessed', false) == false
        && request.resource.data.get('paymentStatus', 'unpaid') in ['unpaid', 'pending']
        && !request.resource.data.keys().hasAny([
          'commission', 'platformFee', 'providerAmount', 'payoutStatus',
          'transactionId', 'cashbackGranted'
        ]);
      // Client/prestador só marcam review. Status/preço/repasse: Cloud Functions (Admin SDK).
      allow update: if isAdmin() || (
        isAuth() &&
        (resource.data.clientId == uid() || resource.data.providerId == uid()) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviewed']) &&
        resource.data.status == 'completed' &&
        request.resource.data.reviewed == true
      );
      allow delete: if isAdmin();
    }

    match /chatRooms/{roomId} {
      function roomParticipants() {
        return get(/databases/$(database)/documents/chatRooms/$(roomId)).data.participants;
      }
      allow read: if isAuth() && request.auth.uid in resource.data.participants;
      allow create: if isAuth() &&
        request.auth.uid in request.resource.data.participants;
      allow update: if isAuth() && request.auth.uid in resource.data.participants;

      match /messages/{msgId} {
        allow read: if isAuth() && request.auth.uid in roomParticipants();
        allow create: if isAuth() &&
          request.resource.data.senderId == request.auth.uid &&
          request.auth.uid in roomParticipants();
        allow update: if isAuth() && request.auth.uid in roomParticipants() && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) &&
            resource.data.senderId != request.auth.uid) ||
          (resource.data.senderId == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['deleted', 'text', 'mediaUrl']))
        );
      }
    }

    match /wallets/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    match /transactions/{txId} {
      allow read: if isAuth() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }

    match /payments/{paymentId} {
      allow read: if isAuth() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /financialAudits/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /rateLimits/{id} {
      allow read, write: if false;
    }

    match /deliveries/{deliveryId} {
      allow read: if isAuth() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        resource.data.delivererId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuth() &&
        request.resource.data.clientId == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        resource.data.delivererId == request.auth.uid ||
        isAdmin()
      );
    }

    match /appointments/{appointmentId} {
      allow read: if isAuth() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.providerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuth() &&
        request.resource.data.clientId == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.providerId == request.auth.uid ||
        isAdmin()
      );
    }

    match /favorites/{favId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuth()
        && request.resource.data.clientId == uid()
        && reviewId == request.resource.data.orderId + '_' + uid()
        && request.resource.data.orderId is string
        && request.resource.data.orderId.size() > 0
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5
        && exists(/databases/$(database)/documents/orders/$(request.resource.data.orderId))
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.clientId
             == uid()
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.status
             == 'completed';
      allow update, delete: if false;
    }

    match /notifications/{notifId} {
      allow read: if isAuth() && resource.data.userId == uid();
      allow update: if isAuth() && resource.data.userId == uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false;
    }

    match /reports/{reportId} {
      allow create: if isAuth() && request.resource.data.reporterId == uid();
      allow read, update: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /support/{ticketId} {
      allow read: if isAdmin() || (isAuth() && resource.data.userId == uid());
      allow create: if isAuth() && request.resource.data.userId == uid();
      allow update: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /config/{doc} {
      allow read: if doc == 'ai' ? isAdmin() : true;
      allow write: if isAdmin();
    }

    match /aiConversations/{id} {
      allow read: if isAuth() && resource.data.userId == uid();
      allow write: if false;
    }

    match /aiUsage/{id} {
      allow read: if isAdmin() || (isAuth() && resource.data.userId == uid());
      allow write: if false;
    }

    match /aiAudit/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /aiKnowledge/{id} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    match /resolveRequests/{id} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.clientId == uid();
      allow update: if isAuth() && (
        resource.data.clientId == uid() ||
        isAdmin() ||
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['proposalCount']) &&
          request.resource.data.proposalCount ==
            resource.data.proposalCount + 1
        )
      );
      allow delete: if isAdmin();
    }

    match /resolveProposals/{id} {
      allow read: if isAuth() && (
        resource.data.providerId == uid() ||
        isAdmin() ||
        get(/databases/$(database)/documents/resolveRequests/$(resource.data.requestId)).data.clientId == uid()
      );
      allow create: if isAuth() && request.resource.data.providerId == uid();
      allow update: if isAuth() && (
        resource.data.providerId == uid() ||
        get(/databases/$(database)/documents/resolveRequests/$(resource.data.requestId)).data.clientId == uid() ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /serviceDrafts/{id} {
      allow read: if isAuth() && resource.data.clientId == uid();
      allow write: if false;
    }

    match /orderEvents/{id} {
      allow read: if isAuth() && (
        resource.data.clientId == uid() ||
        resource.data.providerId == uid() ||
        isAdmin()
      );
      allow write: if false;
    }

    match /paymentIntents/{id} {
      allow read: if isAuth() && (resource.data.userId == uid() || isAdmin());
      allow write: if false;
    }

    match /platformAudit/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /scheduleLocks/{id} {
      allow read: if isAuth();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
