<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key><string>ServiçoConecta</string>
	<key>CFBundleIdentifier</key><string>br.com.servicoconecta</string>
	<key>CFBundleName</key><string>ServicoConecta</string>
	<key>CFBundleShortVersionString</key><string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleVersion</key><string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<key>LSRequiresIPhoneOS</key><true/>
	<key>UILaunchStoryboardName</key><string>LaunchScreen</string>
	<key>UISupportedInterfaceOrientations</key><array><string>UIInterfaceOrientationPortrait</string></array>
	<key>UIViewControllerBasedStatusBarAppearance</key><false/>
	<key>NSLocationWhenInUseUsageDescription</key><string>Usamos sua localização para encontrar profissionais próximos e rastrear serviços.</string>
	<key>NSCameraUsageDescription</key><string>Câmera para fotos de perfil e documentação de serviços.</string>
	<key>NSPhotoLibraryUsageDescription</key><string>Acesso às fotos para envio de imagens.</string>
	<key>NSMicrophoneUsageDescription</key><string>Microfone usado para chamadas de vídeo e mensagens de voz no chat.</string>
	<key>io.flutter.embedded_views_preview</key><true/>
	<key>FirebaseAppDelegateProxyEnabled</key><false/>
	<!-- Google Sign-In: substitua REVERSED_CLIENT_ID pelo valor real do
	     seu GoogleService-Info.plist (chave REVERSED_CLIENT_ID) após
	     rodar `flutterfire configure`. Sem isso, o login com Google
	     não retorna para o app no iOS. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>COLE_SEU_REVERSED_CLIENT_ID_AQUI</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
